/* pages/trace/trace.wxss —— 执行轨迹（演示模式：暗色观测台）
 *
 * 这是一个「演示态」主题，与产品亮色「学籍台账」并存，用 page 级局部变量隔离：
 *   NVIDIA 绿只承担一个语义 —— 算力 / 激活（GPU 表 + 激活的 skill 节点 + 连线）。
 * 动效原则（见 docs/UI-DESIGN-SYSTEM.md §演示页）：
 *   · 只动画 transform / opacity，不碰 width/height/top/left
 *   · 无常驻动画循环：拓扑脉冲由 skill 事件触发，约 1.8s 后自行停止
 *   · 数据文件流入 / 印章落章等一次性动效走 animation（跑完即停）
 */

page {
  --dbg: #0D1826;
  --dpanel: #14202F;
  --dpanel2: #1B2A3B;
  --dline: #243447;
  --dtext: #E6EDF5;
  --dmuted: #8B9BAC;
  --dfaint: #5C6E80;
  --nv: #76B900;
  --nv-soft: rgba(118, 185, 0, 0.13);
  --dseal: #E2554A;
  --djade: #3FBF87;

  background: var(--dbg);
}

.page {
  height: 100vh;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  background: var(--dbg);
  color: var(--dtext);
}

/* ── 计时条（常驻）：只显示总耗时 + 运行状态 ───────── */
.tele {
  flex-shrink: 0;
  display: flex;
  align-items: stretch;
  gap: 2rpx;
  background: var(--dline);
  border-bottom: 1rpx solid var(--dline);
}
.g {
  flex: 1;
  min-width: 0;
  padding: 16rpx 18rpx;
  background: var(--dpanel);
}
.g-state {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  padding-left: 24rpx;
  padding-right: 24rpx;
}
.k {
  display: block;
  font-size: 20rpx;
  color: var(--dfaint);
  letter-spacing: 1rpx;
}
.v {
  display: block;
  margin-top: 2rpx;
  font-family: "Songti SC", "STSong", "Noto Serif CJK SC", serif;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.2;
}
.v.mono { font-family: monospace; font-size: 26rpx; }
.g-state .live { margin-top: 0; }
.live {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 4rpx;
  font-size: 19rpx;
  color: var(--djade);
}
.live .dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--djade);
  animation: pulse 1.5s ease-in-out infinite;
}
.live.idle { color: var(--dfaint); }
.live.idle .dot { background: var(--dfaint); animation: none; }
@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.35; }
}

/* ── 操作提示 / 演示标注 ─────────────────────────── */
.hintbar {
  flex-shrink: 0;
  padding: 0 28rpx 6rpx;
}
.tip {
  font-size: 20rpx;
  color: var(--dfaint);
}
.demo-note {
  flex-shrink: 0;
  margin: 0 28rpx 10rpx;
  padding: 10rpx 16rpx;
  border-radius: 10rpx;
  background: var(--dpanel);
  border-left: 6rpx solid var(--dseal);
  color: var(--dmuted);
  font-size: 20rpx;
  line-height: 1.5;
}

/* ── Agent 拓扑（canvas 2d）───────────────────────── */.topo {
  flex-shrink: 0;
  padding: 18rpx 28rpx 10rpx;
}
.topo-canvas {
  width: 100%;
  height: 200rpx;
}

/* ── 六拍时间轴 ───────────────────────────────────── */
.tl {
  flex: 1;
  min-height: 0;
  padding: 8rpx 28rpx 0;
  box-sizing: border-box;
}
.tl-end { height: 24rpx; }

.step {
  border-radius: 20rpx;
  margin-bottom: 18rpx;
  padding: 16rpx 22rpx;
}
/* 未开始：虚线占位（只有标题行） */
.step.wait {
  border: 1rpx dashed var(--dline);
}
/* 已完成：一行摘要 */
.step.done {
  border: 1rpx solid var(--dline);
  background: var(--dpanel);
}
/* 进行中：点亮 */
.step.run {
  border: 1rpx solid var(--nv);
  background: var(--nv-soft);
  box-shadow: 0 0 44rpx rgba(118, 185, 0, 0.13);
}

.sh {
  display: flex;
  align-items: center;
  gap: 14rpx;
}
.idx {
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: "Songti SC", "STSong", serif;
  font-size: 22rpx;
  font-weight: 600;
  border: 1rpx solid var(--dline);
  color: var(--dfaint);
  background: var(--dbg);
}
.step.done .idx { color: var(--djade); border-color: rgba(63, 191, 135, 0.5); background: rgba(63, 191, 135, 0.12); }
.step.run .idx { color: #0A121C; background: var(--nv); border-color: var(--nv); }
.ttl {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  font-weight: 600;
}
.step.wait .ttl { font-weight: 400; color: var(--dfaint); }
.step.done .ttl { color: var(--dmuted); font-weight: 400; }
.badge {
  flex-shrink: 0;
  font-family: monospace;
  font-size: 19rpx;
  color: var(--nv);
  border: 1rpx solid var(--nv);
  border-radius: 999rpx;
  padding: 4rpx 16rpx;
}
/* 已完成步骤的一行摘要 */
.sum {
  flex-shrink: 0;
  font-family: monospace;
  font-size: 20rpx;
  color: var(--dfaint);
}

.body { margin-top: 16rpx; }

/* 提问 */
.q {
  font-family: "Songti SC", "STSong", serif;
  font-size: 28rpx;
  line-height: 1.6;
}

/* 思考流 / 脑波 / token 瀑布 */
.think {
  font-size: 25rpx;
  line-height: 1.8;
  color: var(--dmuted);
}
/* 运行中的思考流：限高 + 底部对齐，只露出最新几行（老内容从顶部裁掉），
   避免长思考霸屏；波形紧随其下，始终可见。 */
.think-live {
  max-height: 300rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}
.cursor {
  display: inline-block;
  width: 12rpx;
  height: 24rpx;
  background: var(--nv);
  vertical-align: -3rpx;
  margin-left: 4rpx;
  animation: blink 1s steps(1) infinite;
}
@keyframes blink {
  50% { opacity: 0; }
}
.wave {
  position: relative;
  display: flex;
  align-items: flex-end;
  gap: 4rpx;
  height: 56rpx;
  margin-top: 16rpx;
  padding: 6rpx 10rpx;
  border-radius: 12rpx;
  background: #0A121C;
  border: 1rpx solid var(--dline);
  overflow: hidden;
}
.wbar {
  flex: 1;
  background: var(--nv);
  border-radius: 2rpx;
  opacity: 0.55;
  transform-origin: bottom;
  animation: wv 1.1s ease-in-out infinite alternate;
}
@keyframes wv {
  from { transform: scaleY(0.35); }
  to { transform: scaleY(1); }
}
.wave-lbl {
  position: absolute;
  left: 16rpx;
  top: 10rpx;
  font-family: monospace;
  font-size: 18rpx;
  color: var(--dfaint);
}
.wave-tk {
  position: absolute;
  right: 16rpx;
  top: 10rpx;
  font-family: monospace;
  font-size: 18rpx;
  color: var(--nv);
}
.toks {
  display: flex;
  align-items: center;
  gap: 4rpx;
  height: 28rpx;
  margin-top: 14rpx;
}
.toks .blk {
  flex: 1;
  height: 100%;
  border-radius: 3rpx;
  background: var(--nv);
  opacity: 0.22;
}
.toks .blk.on { opacity: 0.95; }
.toks .blk.fade { opacity: 0.5; }

/* 命中 Skill */
.skill {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 18rpx 22rpx;
  border-radius: 16rpx;
  border: 1rpx solid var(--nv);
  background: var(--nv-soft);
  margin-bottom: 12rpx;   /* 多个 skill 之间的间距 */
}
.gem {
  width: 48rpx;
  height: 48rpx;
  flex-shrink: 0;
  border-radius: 14rpx;
  background: var(--nv);
  display: flex;
  align-items: center;
  justify-content: center;
}
/* 纯 CSS 画的菱形（不依赖任何字体/符号，避免缺字） */
.gem::after {
  content: '';
  width: 16rpx;
  height: 16rpx;
  background: #0A121C;
  border-radius: 3rpx;
  transform: rotate(45deg);
}
.skill-txt { flex: 1; min-width: 0; }
.nm {
  display: block;
  font-family: monospace;
  font-size: 25rpx;
  font-weight: 600;
  color: var(--nv);
  word-break: break-all;
}
.why {
  display: block;
  margin-top: 4rpx;
  font-size: 21rpx;
  color: var(--dmuted);
}
/* 开始计算 / 搜索 */
.sub {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 14rpx 0;
  font-size: 24rpx;
  color: var(--dmuted);
}
.sub + .sub { border-top: 1rpx solid var(--dline); }
.sub-ck { flex-shrink: 0; color: var(--dfaint); }
.sub-ck.done { color: var(--djade); }
.sub-ck.run { color: var(--nv); }
.sub-f {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.sub-t {
  flex-shrink: 0;
  font-family: monospace;
  font-size: 20rpx;
  color: var(--dfaint);
}
.files {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 14rpx;
}
.fchip {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  border: 1rpx solid var(--dline);
  background: var(--dpanel2);
  font-family: monospace;
  font-size: 19rpx;
  color: var(--dmuted);
  animation: fly 0.9s ease-out both;
}
@keyframes fly {
  from { opacity: 0; transform: translateX(-28rpx); }
  to { opacity: 1; transform: none; }
}
.dt {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--nv);
  flex-shrink: 0;
}

/* 得到结果 */
.res-wrap { position: relative; padding-right: 132rpx; }
.res {
  font-size: 25rpx;
  line-height: 1.85;
  color: var(--dmuted);
}
.stamp {
  position: absolute;
  right: 0;
  top: 0;
  width: 112rpx;
  height: 112rpx;
  border: 6rpx solid var(--dseal);
  border-radius: 18rpx;
  color: var(--dseal);
  background: rgba(226, 85, 74, 0.06);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  font-family: "Songti SC", "STSong", serif;
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  transform: rotate(-9deg);
  animation: stamp 0.5s cubic-bezier(0.2, 1.5, 0.4, 1) both;
}
@keyframes stamp {
  from { opacity: 0; transform: rotate(-9deg) scale(1.9); }
  to { opacity: 0.92; transform: rotate(-9deg) scale(1); }
}
.stamp-sub {
  font-family: sans-serif;
  font-size: 17rpx;
  font-weight: 400;
  letter-spacing: 0;
  margin-top: 2rpx;
}
.arts {
  margin-top: 16rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.08);
}
.art {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 14rpx 0;
  font-size: 22rpx;
  color: var(--dmuted);
}
.art-l { flex: 1; min-width: 0; }
.art-r {
  font-family: "Songti SC", "STSong", serif;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--dtext);
}
.metrics {
  display: flex;
  margin-top: 18rpx;
  border-radius: 14rpx;
  overflow: hidden;
  background: var(--dline);
  gap: 1rpx;
}
.metric {
  flex: 1;
  padding: 14rpx 8rpx;
  background: var(--dpanel);
  display: flex;
  flex-direction: column;
  align-items: center;
}
.mk { font-size: 19rpx; color: var(--dfaint); }
.mv {
  font-family: "Songti SC", "STSong", serif;
  font-size: 32rpx;
  font-weight: 600;
  margin-top: 2rpx;
}
.mv.nv { color: var(--nv); }

/* ── 演示控制条（常驻）────────────────────────────── */
.ctrl {
  flex-shrink: 0;
  display: flex;
  gap: 16rpx;
  padding: 18rpx 28rpx calc(18rpx + env(safe-area-inset-bottom));
  background: var(--dpanel);
  border-top: 1rpx solid var(--dline);
}
.btn {
  flex: 1;
  height: 84rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 600;
}
.btn.pri { background: var(--nv); color: #0A121C; }
.btn.gho { border: 1rpx solid var(--dline); color: var(--dmuted); }
.btn:active { opacity: 0.8; }

/* pages/chatbot/chatbot.wxss —— 对话页（「学籍台账」视觉系统） */

page {
  height: 100vh;
  background: var(--canvas);
}

.page {
  height: 100vh;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  color: var(--ink);
}

/* ── 版头：登录状态 + 更多 ── */
.who {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
}
.who-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--line);
}
.who-dot-on { background: var(--jade); }
.who-text {
  font-size: var(--fs-micro);
  color: var(--ink-3);
}

/* ── 消息区 ── */
.messages {
  flex: 1;
  height: 0;
  min-height: 0;
  box-sizing: border-box;
  padding: 28rpx 24rpx;
}

.message-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}
.message-row-user { justify-content: flex-end; }
.message-row-assistant { justify-content: flex-start; }

/* 一条消息 = 气泡行 + 可选的「执行过程」折叠条 */
.msg-block { margin-bottom: 24rpx; }

/* 助手印章头像 */
.seal-mark {
  width: 56rpx;
  height: 56rpx;
  flex-shrink: 0;
  border-radius: 12rpx;
  background: var(--seal);
  color: #fff;
  font-size: 30rpx;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: "Songti SC", "STSong", "Noto Serif CJK SC", "Noto Serif SC", serif;
}

.bubble {
  max-width: 76%;
  box-sizing: border-box;
  padding: 22rpx 26rpx;
  border-radius: var(--r-md);
  font-size: var(--fs-body-lg);
  line-height: 1.75;
  word-break: break-word;
  white-space: pre-wrap;
  overflow: hidden;   /* 兜底：内联折行样式失效时也不撑出屏幕 */
  user-select: text;
  -webkit-user-select: text;
}
.bubble-assistant {
  color: var(--ink-2);
  background: var(--paper);
  border: 1rpx solid var(--line);
}
.bubble-user {
  color: #EAF0F6;
  background: var(--ink);
}
.bubble-loading { color: var(--ink-3); }

/* 助手返回的表格（rich-text 内联样式兜底） */
rich-text table {
  width: 100%;
  border-collapse: collapse;
  margin: 10rpx 0;
}
rich-text th,
rich-text td {
  border: 1rpx solid var(--line);
  padding: 8rpx 12rpx;
  text-align: left;
  word-break: break-word;
}
rich-text th {
  background: var(--canvas);
  font-weight: 600;
}

/* ── 执行过程折叠条（默认收起；亮色，沿用产品墨/玉色）── */
.trace-wrap {
  margin-left: 72rpx;      /* 与助手气泡左缘对齐（印章 56rpx + 间距 16rpx） */
  margin-top: 14rpx;
}
.tracebar {
  display: flex;
  align-items: center;
  gap: 14rpx;
  min-height: 80rpx;
  padding: 16rpx 24rpx;
  box-sizing: border-box;
  background: var(--paper);
  border: 1rpx solid var(--line);
  border-radius: var(--r-md);
}
.tracebar:active { background: var(--canvas); }
.trace-ic {
  width: 30rpx;
  height: 30rpx;
  flex-shrink: 0;
  border-radius: 50%;
  background: var(--jade-soft);
  color: var(--jade);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
}
.trace-t { font-size: 25rpx; color: var(--ink-3); }
.trace-m {
  margin-left: auto;
  font-size: 23rpx;
  font-weight: 600;
  color: var(--jade);
}
.trace-arw { font-size: 20rpx; color: #B7C0CB; }

.trace-panel {
  margin-top: 10rpx;
  background: var(--paper);
  border: 1rpx solid var(--line);
  border-radius: var(--r-md);
  overflow: hidden;
}
.trace-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 16rpx 24rpx;
  font-size: 23rpx;
  color: var(--ink-2);
}
.trace-row + .trace-row { border-top: 1rpx solid var(--line); }
.trace-ck { flex-shrink: 0; color: var(--jade); }
.trace-f { flex: 1; min-width: 0; word-break: break-all; }
.trace-m2 {
  flex-shrink: 0;
  font-family: monospace;
  font-size: 20rpx;
  color: var(--ink-3);
}
.trace-full {
  padding: 20rpx 24rpx;
  text-align: center;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--ink);
  border-top: 1rpx solid var(--line);
}
.trace-full:active { background: var(--canvas); }

/* ── 空态引导问题 ── */
.suggest { margin-top: 8rpx; }
.suggest-label {
  display: block;
  margin: 0 4rpx 16rpx;
  font-size: var(--fs-meta);
  color: var(--ink-3);
}
.suggest-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.suggest-chip {
  padding: 18rpx 28rpx;
  border-radius: var(--r-pill);
  background: var(--paper);
  border: 1rpx solid var(--line);
  font-size: 26rpx;
  line-height: 1.2;
  color: var(--ink);
}
.suggest-chip:active { background: var(--canvas); }

/* ── 输入区 ── */
.composer {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: var(--paper);
  border-top: 1rpx solid var(--line);
}
.chat-input {
  flex: 1;
  min-height: 80rpx;
  max-height: 200rpx;
  padding: 16rpx 24rpx;
  box-sizing: border-box;
  border: none;
  border-radius: 12rpx;
  background: var(--canvas);
  font-size: var(--fs-body-lg);
  line-height: 44rpx;
}
.send-button {
  width: 80rpx;
  height: 80rpx;
  flex-shrink: 0;
  border-radius: 50%;
  background: var(--ink);
  display: flex;
  align-items: center;
  justify-content: center;
}
.send-button:active { opacity: .85; }
.send-disabled { background: #AFC2D6; }
.send-loading {
  width: 34rpx;
  height: 34rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.35);
  border-top-color: #fff;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

/* ── 更多操作弹层 ── */
.menu-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 120;
  background: rgba(23, 50, 77, 0.45);
  display: flex;
  align-items: flex-end;
}
.menu-sheet {
  width: 100%;
  box-sizing: border-box;
  background: var(--paper);
  border-radius: 32rpx 32rpx 0 0;
  padding: 16rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
}
.menu-item {
  height: 100rpx;
  line-height: 100rpx;
  text-align: center;
  font-size: var(--fs-body-lg);
  color: var(--ink);
  border-radius: 14rpx;
}
.menu-item:active { background: var(--canvas); }
.menu-cancel {
  margin-top: 8rpx;
  color: var(--ink-3);
  border-top: 1rpx solid var(--line);
}

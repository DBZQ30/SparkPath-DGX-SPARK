<view class="page">
  <view class="head">
    <text class="title ui-num">{{displayName}}</text>
    <text class="ui-note">入库后不保留原始文件，以下为知识片段拼回的文本</text>
  </view>

  <view wx:if="{{loading}}" class="ui-loading"><view class="ui-spinner"></view>加载中…</view>
  <view wx:elif="{{loadFailed}}" class="ui-empty ui-note-danger" bindtap="retry">加载失败，点击重试</view>
  <block wx:else>
    <scroll-view class="body" scroll-y>
      <text class="text" user-select="{{true}}">{{text}}</text>
    </scroll-view>
    <view wx:if="{{truncated}}" class="foot ui-note">仅显示前 2 万字</view>
  </block>
</view>

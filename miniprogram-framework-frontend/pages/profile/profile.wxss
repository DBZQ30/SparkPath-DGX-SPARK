/* pages/profile/profile.wxss —— 我的档案（「学籍台账」视觉系统） */

page {
  background: var(--canvas);
  min-height: 100vh;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.title-flat { margin-bottom: 0; }

/* ── 手机号 ── */
.phone-row { margin-top: 8rpx; }
.phone-val {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.phone-num {
  font-size: var(--fs-body);
  font-weight: 600;
}
.phone-btn {
  display: block;
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  margin-top: 24rpx;
  text-align: center;
  border-radius: 14rpx;
  border: none;
  background: var(--ink);
  color: #fff;
  font-size: var(--fs-body-lg);
  font-weight: 600;
}
.phone-btn::after { border: none; }
.phone-btn:active { opacity: .85; }
.phone-hint { display: block; margin-top: 16rpx; }

/* ── 字段行 ── */
.field-row {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  padding: 22rpx 0;
  border-top: 1rpx solid var(--line);
}
.field-row:first-of-type { border-top: none; }
.field-k {
  width: 180rpx;
  flex-shrink: 0;
  font-size: var(--fs-meta);
  color: var(--ink-3);
}
.field-v {
  flex: 1;
  font-size: var(--fs-body);
  color: var(--ink);
  word-break: break-all;
}

/* ── 空态 / 学号匹配 ── */
.empty-inline { padding: 20rpx 0 0; }
.empty-title {
  display: block;
  margin-bottom: 12rpx;
  font-size: var(--fs-body-lg);
  font-weight: 600;
  color: var(--ink);
}
.link-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 24rpx;
}
.link-input { flex: 1; }

/* ── 管理员入口行 ── */
.item-flush { padding-left: 0; padding-right: 0; min-height: 0; }
.item-flush:active { background: transparent; }

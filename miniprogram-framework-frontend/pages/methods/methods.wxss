/* pages/methods/methods.wxss —— 服务页（「学籍台账」视觉系统） */

page {
  background: var(--canvas);
  min-height: 100vh;
}

.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

.content {
  padding: 24rpx 32rpx 48rpx;
  box-sizing: border-box;
}

.login-hint {
  margin: 20rpx 4rpx 0;
  font-size: var(--fs-meta);
  color: var(--seal);
}

/* ── 处理中 ── */
.loading-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 200;
  background: rgba(243, 245, 248, 0.85);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.loading-spinner {
  width: 72rpx;
  height: 72rpx;
  margin-bottom: 20rpx;
  border: 4rpx solid var(--line);
  border-top-color: var(--ink);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}
.loading-text {
  font-size: var(--fs-body);
  color: var(--ink-3);
}

/* ── 操作结果 ── */
.result-overlay {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 150;
  background: rgba(23, 50, 77, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
}
.result-card {
  width: 660rpx;
  max-height: 75vh;
  background: var(--paper);
  border-radius: var(--r-md);
  overflow: hidden;
}
.result-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx;
  border-bottom: 1rpx solid var(--line);
}
.result-title {
  font-size: var(--fs-body-lg);
  font-weight: 600;
  color: var(--ink);
}
.result-close {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.result-body {
  padding: 32rpx;
  max-height: 58vh;
}
.result-text {
  font-size: var(--fs-body);
  line-height: 46rpx;
  color: var(--ink-2);
  white-space: pre-wrap;
}

/* ── 认证申请弹窗 ── */
.modal-overlay {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  background: rgba(23, 50, 77, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
}
.modal-card {
  width: 640rpx;
  padding: 44rpx 40rpx;
  background: var(--paper);
  border-radius: var(--r-md);
}
.modal-title {
  font-size: var(--fs-head);
  font-weight: 600;
  color: var(--ink);
  margin-bottom: 30rpx;
  text-align: center;
}
.modal-input {
  display: block;
  width: 100%;
  min-height: 88rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-sizing: border-box;
  line-height: 44rpx;
  border: 1rpx solid var(--line);
  border-radius: 12rpx;
  font-size: var(--fs-body);
  color: var(--ink);
}
.modal-btns {
  display: flex;
  gap: 20rpx;
  margin-top: 12rpx;
}

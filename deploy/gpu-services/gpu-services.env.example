# gpu-services.env.example —— GPU 模型服务统一 API Key（模板）
# 复制到 /etc/sparkpath/gpu-services.env 并填入真实值（该文件不入库）。
# systemd 单元通过 EnvironmentFile=-/etc/sparkpath/gpu-services.env 读取。
#
# 用法：
#   sudo mkdir -p /etc/sparkpath
#   sudo cp deploy/gpu-services/gpu-services.env.example /etc/sparkpath/gpu-services.env
#   sudo chmod 600 /etc/sparkpath/gpu-services.env
#   # 编辑填入 API_KEY 后重启服务
#   sudo systemctl restart dgx-embedding dgx-reranker
API_KEY=<在此填写统一 API Key>

# MinerU 单独使用（旧版 start-mineru.sh）
MINERU_API_KEY=<在此填写 MinerU API Key，可与 API_KEY 相同>

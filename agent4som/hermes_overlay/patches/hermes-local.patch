+def _maybe_emit_skill_activate(sid: str, name: str, args: dict, result: str) -> None:
+    """Emit ``skill.activate`` the first time a skill's SKILL.md is loaded.
+
+    Skills are activated by calling the ``skill_view`` tool (see
+    ``tools/skills_tool.py``).  Its result carries the resolved skill name and
+    the frontmatter description, so surface a dedicated event instead of
+    making every consumer special-case ``skill_view`` inside ``tool.complete``.
+
+    Fires once per skill per session.  Loading a linked file (``file_path``)
+    is a read, not an activation.  Best-effort by design: a malformed or
+    unsuccessful result must never break the tool call, so we only emit when
+    the payload says the load succeeded.
+    """
+    if name != "skill_view":
+        return
+    if (args or {}).get("file_path"):
+        return
+    if not _tool_progress_enabled(sid):
+        return
+
+    parsed = None
+    if isinstance(result, str):
+        try:
+            parsed = json.loads(result)
+        except Exception:
+            parsed = None
+
+    skill_name = ""
+    description = ""
+    if isinstance(parsed, dict):
+        if not parsed.get("success"):
+            return
+        skill_name = str(parsed.get("name") or "")
+        description = str(parsed.get("description") or "")
+    # Qualified/aliased calls may not echo a resolved name — fall back to what
+    # the model asked for so the event still names the skill.
+    skill_name = skill_name or str((args or {}).get("name") or "")
+    if not skill_name:
+        return
+
+    session = _sessions.get(sid)
+    seen = session.setdefault("activated_skills", set()) if session is not None else set()
+    if skill_name in seen:
+        return
+    seen.add(skill_name)
+
+    payload: dict[str, object] = {"name": skill_name, "source": "skill_view"}
+    if description:
+        payload["description"] = description
+    try:
+        _emit("skill.activate", sid, payload)
+    except Exception:
+        pass
+
+

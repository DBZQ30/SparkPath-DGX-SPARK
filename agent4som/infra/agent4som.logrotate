# Agent for SOM — logrotate 配置
# 部署: sudo cp infra/agent4som.logrotate /etc/logrotate.d/agent4som
#
# systemd timer 驱动的服务日志经 journald 处理（见 infra/journald.conf.snippet），
# 本文件只轮转应用直接写入 data/logs/ 的日志文件。

/home/<DGX_USER>/SparkPath-DGX-SPARK/agent4som/data/logs/*.log {
    daily
    rotate 30
    missingok
    notifempty
    compress
    delaycompress
    copytruncate
    maxsize 50M
    create 0644 <DGX_USER> <DGX_USER>
    su <DGX_USER> <DGX_USER>
}

/home/<DGX_USER>/SparkPath-DGX-SPARK/agent4som/data/jxtz_sync.log {
    weekly
    rotate 12
    missingok
    notifempty
    compress
    delaycompress
    copytruncate
    create 0644 <DGX_USER> <DGX_USER>
    su <DGX_USER> <DGX_USER>
}

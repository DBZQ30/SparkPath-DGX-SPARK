[Unit]
Description=JWC Teaching Notice Incremental Sync
After=network.target chroma-server.service
Wants=chroma-server.service

[Service]
Type=oneshot
User=<DGX_USER>
Group=<DGX_USER>
WorkingDirectory=/home/<DGX_USER>/SparkPath-DGX-SPARK/agent4som
ExecStart=/home/<DGX_USER>/SparkPath-DGX-SPARK/agent4som/venv/bin/python scripts/sync_jxtz.py
StandardOutput=journal
StandardError=journal

# Security hardening
NoNewPrivileges=yes
PrivateTmp=yes
ReadWritePaths=/home/<DGX_USER>/SparkPath-DGX-SPARK/agent4som/data
PrivateDevices=yes
RestrictAddressFamilies=AF_INET AF_INET6
RestrictRealtime=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes

# ============================================================================
# 本科新生学业规划智能助手 — 小程序网关环境变量模板
# ============================================================================
# 复制为 .env 并填入实际值:  cp .env.example .env
# .env 已在 .gitignore 中排除，切勿提交。
#
# 必填（小程序登录 code2session 与 session token 签发）：
#   WECHAT_MINIAPP_APPID     小程序 AppID
#   WECHAT_MINIAPP_APPSECRET 小程序 AppSecret
#   MINIAPP_SESSION_SECRET   HMAC 密钥，用于签发/校验小程序会话 token
#
# 注：适配器监听地址与允许来源（host / port / allowed_origins）**不是环境变量**，
#     在 config.yaml 的 platforms.miniapp.extra.* 中配置。
# ============================================================================

WECHAT_MINIAPP_APPID=
WECHAT_MINIAPP_APPSECRET=
MINIAPP_SESSION_SECRET=

# 会话 token 备选密钥（与 MINIAPP_SESSION_SECRET 二选一，未设则用后者）
ADMISSION_CONTEXT_SECRET=

# 允许任意小程序用户（仅本地调试可 true；**生产必须 false**，默认 false）
MINIAPP_ALLOW_ALL_USERS=false

# 手机号验证模式：留空=走微信验证；dev=本地 mock（跳过微信验证，仅调试）
PHONE_VERIFY_MODE=

# agent4som 仓库根绝对路径（适配器运行记录 / 上传目录锚点；跑的是部署副本，不能用 __file__）
AGENT4SOM_REPO=/home/<DGX_USER>/SparkPath-DGX-SPARK/agent4som

# ChromaDB 数据目录（留空则用 agent4som/data/chroma）
CHROMA_DB_PATH=

# ---- 可选：云端主对话模型（仅当 config.yaml: model.provider=stepfun 时需要）----
# 默认走本地 vLLM（config.yaml: provider=local / qwen3.8-27b），以下可留空
STEPFUN_API_KEY=
STEPFUN_BASE_URL=https://api.stepfun.com/step_plan/v1

# ---- 其余模型侧凭据（embedding / rerank / MinerU 等）------------------------
DEEPSEEK_API_KEY=
QWEN_API_KEY=
